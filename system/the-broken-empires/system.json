  "relationships": {
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "reason": "Optional. The Broken Empires colours its dice by what they are: attack, defence and Wound Die roll in their own colours, which the GM and each player can change under \"Dice Roles\". Without it everything works, the dice simply are not animated."
      },
      {
        "id": "zone-movement",
        "type": "module",
        "reason": "Optional. TBE measures in zones rather than squares. This module makes the ruler and token dragging count zones defined as Scene Regions, the same Regions TBE: Zone Hazards marks as Obscured, Confined and so on."
      }
    ]
  }
