<form class="{{cssClass}} {{item.type}} flexcol" autocomplete="off">

  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="80" width="80"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Name"/></h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="details">Details</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  <section class="sheet-body">
    <div class="tab details" data-group="primary" data-tab="details">
      <div class="resources grid grid-3col">
        <div class="resource flex-group-center">
          <label class="resource-label">Damage</label>
          <input type="text" name="system.dmg" value="{{system.dmg}}" data-dtype="Number"/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Non-Lethal</label>
          <input type="checkbox" name="system.nl" {{checked system.nl}}/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Ranged</label>
          <input type="checkbox" name="system.ranged" {{checked system.ranged}}/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Linked Skill</label>
          <input type="text" name="system.skillName" value="{{system.skillName}}"/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label" title="Ch.9 p.129 Encumbrance">ENC</label>
          <input type="text" name="system.enc" value="{{system.enc}}" data-dtype="Number"/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label" title="At Hand shares a 6 ENC pool; Stored counts against Inventory ENC instead">Carried</label>
          <select name="system.carried">
            <option value="ready" {{#if (eq system.carried "ready")}}selected{{/if}}>Held and Ready (no action)</option>
            <option value="hand" {{#if (eq system.carried "hand")}}selected{{/if}}>At Hand (Minor Action to draw)</option>
            <option value="stored" {{#if (eq system.carried "stored")}}selected{{/if}}>Stored (2 full actions to retrieve)</option>
          </select>
        </div>
      </div>
      <h3>Combat Maneuver Costs (SL)</h3>
      <div class="resources grid grid-4col">
        <div class="resource flex-group-center">
          <label class="resource-label">Choose Loc.</label>
          <input type="text" name="system.cl" value="{{system.cl}}" data-dtype="Number"/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Circumvent Shield</label>
          <input type="text" name="system.cs" value="{{system.cs}}" data-dtype="Number"/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Disarm</label>
          <input type="text" name="system.dis" value="{{system.dis}}" data-dtype="Number"/>
        </div>
        <div class="resource flex-group-center">
          <label class="resource-label">Trip</label>
          <input type="text" name="system.t" value="{{system.t}}" data-dtype="Number"/>
        </div>
      </div>
    </div>
    <div class="tab description" data-group="primary" data-tab="description">
      {{editor enrichedDescription target="system.description" engine="prosemirror" button=true editable=editable}}
    </div>
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/the-broken-empires/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>
</form>
