<div class="gear-list">
  <div class="enc-summary" style="display:flex;gap:16px;align-items:center;font-size:12px;margin-bottom:6px;padding:4px 6px;border:1px solid #7a6a4f;border-radius:4px">
    <span>Weapons at Hand <b>{{enc.hand}}</b> / {{enc.handMax}}</span>
    <span>Inventory ENC <b>{{enc.inv}}</b> / {{enc.invMax}}</span>
    {{#if enc.penalty}}
    <span style="color:#b04040"><b>{{enc.penalty}}</b> to physical-activity rolls (Athletics, Combat skills){{#if enc.overCap}}, over the 9-point cap: not a legal load{{/if}}</span>
    {{/if}}
    <span style="margin-left:auto">Inventory bonus (Strong Back etc.): <input type="text" name="system.enc.invBonus" value="{{system.enc.invBonus}}" data-dtype="Number" style="width:36px"/></span>
  </div>
  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">Weapon</div>
      <div class="item-prop">Dmg</div>
      <div class="item-prop">CL / CS / Dis / T</div>
      <div class="item-prop">Skill</div>
      <div class="item-prop">ENC</div>
      <div class="item-controls">
        <a class="item-control item-create" title="Create Weapon" data-type="weapon">
          <i class="fas fa-plus"></i> New Weapon
        </a>
      </div>
    </li>
    {{#each weapons as |item|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <img class="item-image" src="{{item.img}}" width="20" height="20"/>
        {{!-- Clicking the weapon rolls the attack with it, the same way
              clicking a skill rolls the skill. Everything past the roll --
              hit location, damage, Maneuvers, wounds -- is still TBE: Attack's,
              because it needs two actors. --}}
        <h4 class="weapon-roll rollable" title="Roll an attack with {{item.name}}">{{item.name}}</h4>
        {{#if item.system.ranged}}<span class="tag">Ranged</span>{{/if}}
        {{#if item.system.nl}}<span class="tag">NL</span>{{/if}}
      </div>
      <div class="item-prop">{{item.system.dmg}}</div>
      <div class="item-prop">{{item.system.cl}} / {{item.system.cs}} / {{item.system.dis}} / {{item.system.t}}</div>
      <div class="item-prop">{{item.system.skillName}}</div>
      {{!-- The label comes from the readiness owner, not a chain of eq helpers.
            The chain that used to be here read "stored", then "ready", then
            fell through to "at hand" for everything else -- so a DROPPED
            weapon displayed as "(at hand)". That is the same negative-filter
            bug v0.35.0/v0.37.0 chased through four files, in template form:
            an else branch over an open enum is a default that silently
            absorbs every value added later. --}}
      <div class="item-prop">{{item.system.enc}} ({{item.readiness.short}})</div>
      <div class="item-controls">
        <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{else}}
    <li class="item-empty">&mdash; none &mdash;</li>
    {{/each}}
  </ol>

  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">Armor</div>
      <div class="item-prop">AP</div>
      <div class="item-prop">Bulk</div>
      <div class="item-prop">Locations</div>
      <div class="item-prop">Worn?</div>
      <div class="item-controls">
        <a class="item-control item-create" title="Create Armor" data-type="armor">
          <i class="fas fa-plus"></i> New Armor
        </a>
      </div>
    </li>
    {{#each armor as |item|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <img class="item-image" src="{{item.img}}" width="20" height="20"/>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop">{{item.system.ap}}</div>
      <div class="item-prop">{{item.system.bulk}}</div>
      <div class="item-prop">{{armorLocs item.system.locations}}</div>
      <div class="item-prop">{{#if item.system.equipped}}yes{{else}}no (1 ENC){{/if}}</div>
      <div class="item-controls">
        <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{else}}
    <li class="item-empty">&mdash; none &mdash;</li>
    {{/each}}
  </ol>
  {{#if armor.length}}
  <div class="armor-penalty-summary" style="font-size:11px;opacity:.85;margin:-4px 0 8px">
    Total worn Bulk <b>{{armorPenalty.bulk}}</b> &rarr; Initiative penalty <b>-{{armorPenalty.penalty}}</b> (Bulk/3, rounded up, worn armor only; Ch.9 p.141) &mdash; effective Initiative shown on the Overview tab.
  </div>
  {{/if}}

  <ol class="items-list">
    <li class="item flexrow items-header">
      <div class="item-name">Shield</div>
      <div class="item-prop">AP</div>
      <div class="item-prop">ENC</div>
      <div class="item-controls">
        <a class="item-control item-create" title="Create Shield" data-type="shield">
          <i class="fas fa-plus"></i> New Shield
        </a>
      </div>
    </li>
    {{#each shields as |item|}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <img class="item-image" src="{{item.img}}" width="20" height="20"/>
        <h4>{{item.name}}</h4>
      </div>
      <div class="item-prop">{{item.system.ap}}</div>
      {{!-- Same owner as the weapon rows above, same reason. --}}
      <div class="item-prop">{{item.system.enc}} ({{item.readiness.short}})</div>
      <div class="item-controls">
        <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{else}}
    <li class="item-empty">&mdash; none &mdash;</li>
    {{/each}}
  </ol>
</div>
